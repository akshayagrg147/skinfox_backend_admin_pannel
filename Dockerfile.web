FROM node:20-bookworm-slim AS build

WORKDIR /app
COPY package*.json ./
COPY admin/package.json admin/package.json
COPY affiliate/package.json affiliate/package.json
COPY server/package.json server/package.json
COPY packages/contracts/package.json packages/contracts/package.json
RUN npm ci

COPY . .
ARG VITE_AFFILIATE_BASE=/affiliate/
ARG VITE_STOREFRONT_URL
ARG VITE_FIREBASE_API_KEY
ARG VITE_FIREBASE_AUTH_DOMAIN
ARG VITE_FIREBASE_PROJECT_ID
ARG VITE_FIREBASE_STORAGE_BUCKET
ARG VITE_FIREBASE_MESSAGING_SENDER_ID
ARG VITE_FIREBASE_APP_ID
ENV VITE_AFFILIATE_BASE=$VITE_AFFILIATE_BASE
ENV VITE_STOREFRONT_URL=$VITE_STOREFRONT_URL
ENV VITE_FIREBASE_API_KEY=$VITE_FIREBASE_API_KEY
ENV VITE_FIREBASE_AUTH_DOMAIN=$VITE_FIREBASE_AUTH_DOMAIN
ENV VITE_FIREBASE_PROJECT_ID=$VITE_FIREBASE_PROJECT_ID
ENV VITE_FIREBASE_STORAGE_BUCKET=$VITE_FIREBASE_STORAGE_BUCKET
ENV VITE_FIREBASE_MESSAGING_SENDER_ID=$VITE_FIREBASE_MESSAGING_SENDER_ID
ENV VITE_FIREBASE_APP_ID=$VITE_FIREBASE_APP_ID
RUN npm run build && npm run build --workspace admin && npm run build --workspace affiliate

FROM nginx:1.27-alpine
COPY --from=build /app/dist /usr/share/nginx/html/storefront
COPY --from=build /app/admin/dist /usr/share/nginx/html/admin
COPY --from=build /app/affiliate/dist /usr/share/nginx/html/affiliate
# Admin is served from a dedicated nginx root, so it needs the shared logo
# assets copied alongside its generated files.
COPY --from=build /app/public/brand /usr/share/nginx/html/admin/brand
COPY deploy/nginx.conf /etc/nginx/conf.d/default.conf
