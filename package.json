{
  "name": "skinfox-premium-storefront",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=20.19.0 <21 || >=22.12.0"
  },
  "workspaces": [
    "server",
    "admin",
    "affiliate",
    "packages/contracts"
  ],
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "dev:all": "concurrently -k \"npm run dev --workspace server\" \"npm run dev --workspace admin\" \"npm run dev --workspace affiliate\" \"npm run dev\"",
    "build": "tsc -b && vite build && node scripts/prerender.mjs",
    "build:all": "npm run build && npm run build --workspace server && npm run build --workspace admin && npm run build --workspace affiliate",
    "lint": "eslint . --max-warnings=0",
    "test": "vitest run",
    "test:all": "npm test && npm test --workspace server && npm test --workspace admin",
    "preview": "vite preview --host 0.0.0.0"
  },
  "dependencies": {
    "@react-three/drei": "9.122.0",
    "@react-three/fiber": "8.17.14",
    "@tanstack/react-query": "^5.90.5",
    "firebase": "^12.18.0",
    "framer-motion": "^12.23.12",
    "lucide-react": "^0.542.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "three": "0.170.0"
  },
  "devDependencies": {
    "@eslint/js": "9.31.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.8.0",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^24.3.0",
    "@types/react": "18.3.20",
    "@types/react-dom": "18.3.5",
    "@types/three": "0.170.0",
    "@vitejs/plugin-react": "5.2.0",
    "concurrently": "^9.2.1",
    "eslint": "9.31.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "0.4.18",
    "globals": "16.0.0",
    "jsdom": "^26.1.0",
    "typescript": "~5.8.3",
    "typescript-eslint": "8.26.0",
    "vite": "7.3.6",
    "vitest": "3.2.6"
  }
}
