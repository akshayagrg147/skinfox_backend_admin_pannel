VITE_API_URL=
# Optional local Vite proxy target. Set this in .env.local to use the hosted
# AWS API/database while developing the frontend without exposing DB secrets.
# Leave unset to use the local API at http://localhost:4000.
VITE_DEV_API_TARGET=http://localhost:4000
# Public Firebase Web App configuration (safe to expose in the browser bundle).
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=skinfox.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=skinfox
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
# Product performance labels in the admin catalogue table.
ADMIN_PRODUCT_SLOW_MAX_UNITS=3
ADMIN_PRODUCT_SELLING_MIN_UNITS=4

# Shipping integration (server-side only; never expose these as VITE_ vars).
# Keep manual mode until credentials, warehouse details and package defaults are verified.
SHIPPING_PROVIDER=manual
DELHIVERY_ENV=production
DELHIVERY_API_TOKEN=
DELHIVERY_API_BASE_URL=
DELHIVERY_CLIENT_NAME=
DELHIVERY_PICKUP_LOCATION=
DELHIVERY_PICKUP_PINCODE=
DELHIVERY_PICKUP_TIME=16:00:00
DELHIVERY_SELLER_NAME=
DELHIVERY_SELLER_ADDRESS=
DELHIVERY_SELLER_PINCODE=
DELHIVERY_SELLER_CITY=
DELHIVERY_SELLER_STATE=
DELHIVERY_SELLER_COUNTRY=India
DELHIVERY_SELLER_GST_TIN=
DELHIVERY_DEFAULT_HSN_CODE=
DELHIVERY_BILLING_MODE=E
DELHIVERY_WEBHOOK_TOKEN=
DELHIVERY_BOOKING_ENABLED=false
SHIPPING_DEFAULT_WEIGHT_KG=0.5
SHIPPING_DEFAULT_LENGTH_CM=
SHIPPING_DEFAULT_BREADTH_CM=
SHIPPING_DEFAULT_HEIGHT_CM=
