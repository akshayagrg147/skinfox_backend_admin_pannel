VITE_API_URL=
# Optional local Vite proxy target. Set this in .env.local to use the hosted
# AWS API/database while developing the frontend without exposing DB secrets.
# Leave unset to use the local API at http://localhost:4000.
VITE_DEV_API_TARGET=http://localhost:4000
# Public Firebase Web App configuration (safe to expose in the browser bundle).
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=skinfox.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=skinfox
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
# Product performance labels in the admin catalogue table.
ADMIN_PRODUCT_SLOW_MAX_UNITS=3
ADMIN_PRODUCT_SELLING_MIN_UNITS=4

# Shipping integration (server-side only; never expose these as VITE_ vars).
# Keep manual mode until credentials, pickup details and package defaults are verified.
SHIPPING_PROVIDER=manual
SHIPROCKET_API_EMAIL=
SHIPROCKET_API_PASSWORD=
SHIPROCKET_API_BASE_URL=https://apiv2.shiprocket.in/v1/external
SHIPROCKET_PICKUP_LOCATION=
SHIPROCKET_PICKUP_PINCODE=
SHIPROCKET_WEBHOOK_TOKEN=
SHIPROCKET_BOOKING_ENABLED=false
SHIPPING_DEFAULT_WEIGHT_KG=0.5
