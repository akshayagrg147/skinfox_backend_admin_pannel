  status    ContactStatus @default(new)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
}

model AnalyticsEvent {
  id          String   @id @default(cuid())
  eventName   String
  anonymousId String
  payload     Json
  consent     Boolean
  createdAt   DateTime @default(now())

  @@index([eventName, createdAt])
}

model CareFinder {
  id          String                 @id @default(cuid())
  name        String
  version     Int                    @default(1)
  active      Boolean                @default(true)
  config      Json?
  questions   CareFinderQuestion[]
  rules       CareFinderRule[]
  submissions CareFinderSubmission[]
}

model CareFinderQuestion {
  id            String             @id @default(cuid())
  careFinderId  String
  key           String
  prompt        String
  sortOrder     Int                @default(0)
  selectionMode String             @default("single")
  required      Boolean            @default(true)
  condition     Json?
  careFinder    CareFinder         @relation(fields: [careFinderId], references: [id], onDelete: Cascade)
  options       CareFinderOption[]

  @@unique([careFinderId, key])
}

model CareFinderOption {
  id          String             @id @default(cuid())
  questionId  String
  value       String
  label       String
  description String?
  sortOrder   Int                @default(0)
  condition   Json?
  question    CareFinderQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)
}

model CareFinderRule {
  id           String     @id @default(cuid())
  careFinderId String
  answerKey    String
  answerValue  String
  productId    String
  weight       Int        @default(1)
  metadata     Json?
  careFinder   CareFinder @relation(fields: [careFinderId], references: [id], onDelete: Cascade)
  product      Product    @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@index([careFinderId, answerKey, answerValue])
}

model CareFinderSubmission {
  id              String     @id @default(cuid())
  careFinderId    String
  answers         Json
  recommendations Json
  careFinder      CareFinder @relation(fields: [careFinderId], references: [id], onDelete: Restrict)
  createdAt       DateTime   @default(now())
}

model StoreSetting {
