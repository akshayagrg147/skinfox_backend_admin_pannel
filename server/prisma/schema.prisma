generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum AdminRole {
  SUPER_ADMIN
  CATALOG_MANAGER
  CONTENT_EDITOR
  ORDER_MANAGER
  SUPPORT_AGENT
  ANALYST
}

enum PurchaseState {
  available
  coming_soon
  out_of_stock
  discontinued
}

enum PublicationStatus {
  draft
  in_review
  approved
  scheduled
  published
  archived
}

enum MediaType {
  image
  video
}

enum FitMode {
  contain
  cover
}

enum PaymentMethod {
  razorpay
  cod
}

enum PaymentStatus {
  pending
  authorised
  captured
  failed
  refunded
  partially_refunded
}

enum WaitlistStatus {
  payment_pending
  joined
  payment_failed
  cancelled
  refund_pending
  refunded
  converted
}

enum OrderStatus {
  pending_payment
  payment_failed
  confirmed
  processing
  packed
  shipped
  delivered
  cancelled
  partially_refunded
  refunded
  return_requested
  returned
}

enum MovementType {
  receipt
  sale
  adjustment
  reservation_release
  reservation_hold
  return
}

enum AffiliateStatus {
  pending
  approved
  rejected
  suspended
}

enum AffiliateWalletEntryType {
  commission
  redemption_request
  redemption_reversal
}

enum AffiliateRedemptionStatus {
  requested
  paid
  rejected
}

enum ClaimReviewStatus {
  pending
  approved
  rejected
  expired
}

enum ContactStatus {
  new
  in_progress
  resolved
  spam
}

model AdminUser {
  id                         String                       @id @default(cuid())
  email                      String                       @unique
  name                       String
  passwordHash               String
  role                       AdminRole                    @default(SUPPORT_AGENT)
  roleId                     String?
  roleRef                    Role?                        @relation(fields: [roleId], references: [id], onDelete: SetNull)
  isActive                   Boolean                      @default(true)
  mfaRequired                Boolean                      @default(false)
  mustChangePassword         Boolean                      @default(true)
  lastLoginAt                DateTime?
  createdAt                  DateTime                     @default(now())
  updatedAt                  DateTime                     @updatedAt
  sessions                   AdminSession[]
  invitations                AdminInvitation[]
  mfaCredential              MfaCredential?
  auditLogs                  AuditLog[]
  revisions                  ProductRevision[]
  approvedAffiliates         Affiliate[]                  @relation("AffiliateApprover")
  affiliateRedemptionReviews AffiliateRedemptionRequest[] @relation("AffiliateRedemptionReviewer")
}

model Role {
  id          String           @id @default(cuid())
  code        AdminRole        @unique
  name        String
  description String?
  users       AdminUser[]
  permissions RolePermission[]
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
}

model Permission {
  id          String           @id @default(cuid())
  key         String           @unique
  description String?
  roles       RolePermission[]
}

model RolePermission {
  roleId       String
  permissionId String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
}

model AdminSession {
  id         String    @id @default(cuid())
  tokenHash  String    @unique
  userId     String
  user       AdminUser @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt  DateTime
  createdAt  DateTime  @default(now())
  lastSeenAt DateTime  @default(now())
  ip         String?
  userAgent  String?
  revokedAt  DateTime?

  @@index([userId, expiresAt])
}

model AdminInvitation {
  id          String    @id @default(cuid())
  email       String
  role        AdminRole
  tokenHash   String    @unique
  invitedById String
  invitedBy   AdminUser @relation(fields: [invitedById], references: [id])
  expiresAt   DateTime
  acceptedAt  DateTime?
  createdAt   DateTime  @default(now())
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  email     String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
}

model MfaCredential {
  id              String    @id @default(cuid())
  userId          String    @unique
  user            AdminUser @relation(fields: [userId], references: [id], onDelete: Cascade)
  secretEncrypted String
  enrolledAt      DateTime?
  verifiedAt      DateTime?
}

model AuditLog {
  id            String     @id @default(cuid())
  actorId       String?
  actor         AdminUser? @relation(fields: [actorId], references: [id], onDelete: SetNull)
  action        String
  entityType    String
  entityId      String?
  beforeSummary Json?
  afterSummary  Json?
  reason        String?
  requestId     String
  ip            String?
  userAgent     String?
  result        String
  createdAt     DateTime   @default(now())

  @@index([entityType, entityId])
  @@index([createdAt])
}

/// Daily photo-analysis usage, keyed per browser (device cookie) and per IP.
/// Persisted rather than in-memory so a server restart cannot reset the quota.
model PhotoAnalysisUsage {
  id        String   @id @default(cuid())
  scope     String
  scopeKey  String
  day       String
  count     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([scope, scopeKey, day])
  @@index([day])
}

model IdempotencyRecord {
  id             String   @id @default(cuid())
  key            String
  scope          String
  requestHash    String
  responseStatus Int?
  responseBody   Json?
  createdAt      DateTime @default(now())
  expiresAt      DateTime

  @@unique([key, scope])
}

model WebhookEvent {
  id          String    @id @default(cuid())
  provider    String
  externalId  String
  eventType   String
  payload     Json
  processedAt DateTime?
  createdAt   DateTime  @default(now())

  @@unique([provider, externalId])
}

model Product {
  id            String              @id @default(cuid())
  slug          String              @unique
  name          String
  subtitle      String
  type          String
  packaging     String
  category      String
  categoryId    String?
  categoryRef   Category?           @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  concern       String
  concerns      String[]
  concernRefs   Concern[]
  tags          Tag[]
  benefit       String
  description   String
  pricePaise    Int?
  mrpPaise      Int?
  size          String
  usage         String
  routineStep   String
  highlights    String[]
  color         String
  accent        String
  tint          String
  image         String
  storyImage    String?
  imageAlt      String
  imagePosition String              @default("50% 50%")
  imageScale    Float               @default(1)
  badge         String?
  purchaseState PurchaseState       @default(coming_soon)
  status        PublicationStatus   @default(published)
  publishedAt   DateTime?
  scheduledAt   DateTime?
  archivedAt    DateTime?
  createdById   String?
  updatedById   String?
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt
  variants      ProductVariant[]
  waitlistItems WaitlistItem[]
  media         ProductMedia[]
  collections   CollectionProduct[]
  ingredients   ProductIngredient[]
  claims        ProductClaim[]
  revisions     ProductRevision[]
  cartItems     CartItem[]
  orderItems    OrderItem[]
  relatedFrom   RelatedProduct[]    @relation("relatedFrom")
  relatedTo     RelatedProduct[]    @relation("relatedTo")
  careRules     CareFinderRule[]

  @@index([status, purchaseState])
}

model ProductVariant {
  id            String                 @id @default(cuid())
  productId     String
  product       Product                @relation(fields: [productId], references: [id], onDelete: Restrict)
  sku           String                 @unique
  name          String
  size          String
  pricePaise    Int?
  mrpPaise      Int?
  purchaseState PurchaseState          @default(coming_soon)
  createdAt     DateTime               @default(now())
  updatedAt     DateTime               @updatedAt
  inventory     InventoryItem[]
  reservations  InventoryReservation[]
  movements     InventoryMovement[]
  cartItems     CartItem[]
  orderItems    OrderItem[]

  @@index([productId])
}

model ProductMedia {
  id             String      @id @default(cuid())
  productId      String
  product        Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  type           MediaType
  src            String
  mobileSrc      String?
  poster         String?
  alt            String
  sortOrder      Int         @default(0)
  width          Int?
  height         Int?
  aspectRatio    Float?
  fitMode        FitMode     @default(contain)
  objectPosition String      @default("50% 50%")
  imageScale     Float       @default(1)
  focalPointX    Float       @default(0.5)
  focalPointY    Float       @default(0.5)
  mediaAssetId   String?
  mediaAsset     MediaAsset? @relation(fields: [mediaAssetId], references: [id], onDelete: SetNull)
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  @@index([productId, sortOrder])
}

model Category {
  id        String    @id @default(cuid())
  name      String    @unique
  slug      String    @unique
  sortOrder Int       @default(0)
  products  Product[]
}

model Concern {
  id        String    @id @default(cuid())
  name      String    @unique
  slug      String    @unique
  sortOrder Int       @default(0)
  products  Product[]
}

model Collection {
  id          String              @id @default(cuid())
  name        String
  slug        String              @unique
  description String?
  status      PublicationStatus   @default(published)
  products    CollectionProduct[]
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
}

model CollectionProduct {
  collectionId String
  productId    String
  sortOrder    Int        @default(0)
  collection   Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  product      Product    @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@id([collectionId, productId])
}

model Tag {
  id       String    @id @default(cuid())
  name     String    @unique
  products Product[]
}

model Ingredient {
  id          String              @id @default(cuid())
  name        String              @unique
  description String?
  products    ProductIngredient[]
}

model ProductIngredient {
  productId    String
  ingredientId String
  sortOrder    Int        @default(0)
  product      Product    @relation(fields: [productId], references: [id], onDelete: Cascade)
  ingredient   Ingredient @relation(fields: [ingredientId], references: [id], onDelete: Cascade)

  @@id([productId, ingredientId])
}

model ProductClaim {
  id           String            @id @default(cuid())
  productId    String
  text         String
  claimType    String
  evidence     String?
  disclaimer   String?
  reviewStatus ClaimReviewStatus @default(pending)
  reviewerId   String?
  approvedAt   DateTime?
  reviewDate   DateTime?
  product      Product           @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
}

model ProductRevision {
  id          String            @id @default(cuid())
  productId   String
  version     Int
  snapshot    Json
  status      PublicationStatus
  createdById String?
  product     Product           @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdBy   AdminUser?        @relation(fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime          @default(now())

  @@unique([productId, version])
}

model RelatedProduct {
  fromProductId String
  toProductId   String
  sortOrder     Int     @default(0)
  fromProduct   Product @relation("relatedFrom", fields: [fromProductId], references: [id], onDelete: Cascade)
  toProduct     Product @relation("relatedTo", fields: [toProductId], references: [id], onDelete: Cascade)

  @@id([fromProductId, toProductId])
}

model InventoryLocation {
  id           String                 @id @default(cuid())
  name         String
  code         String                 @unique
  address      Json?
  isActive     Boolean                @default(true)
  items        InventoryItem[]
  reservations InventoryReservation[]
  movements    InventoryMovement[]
}

model InventoryItem {
  id                String            @id @default(cuid())
  variantId         String
  locationId        String
  availableQty      Int               @default(0)
  reservedQty       Int               @default(0)
  lowStockThreshold Int               @default(5)
  variant           ProductVariant    @relation(fields: [variantId], references: [id], onDelete: Restrict)
  location          InventoryLocation @relation(fields: [locationId], references: [id], onDelete: Restrict)

  @@unique([variantId, locationId])
}

model InventoryReservation {
  id                String            @id @default(cuid())
  variantId         String
  locationId        String
  cartId            String?
  checkoutSessionId String?
  quantity          Int
  expiresAt         DateTime
  releasedAt        DateTime?
  variant           ProductVariant    @relation(fields: [variantId], references: [id], onDelete: Restrict)
  location          InventoryLocation @relation(fields: [locationId], references: [id], onDelete: Restrict)
  checkoutSession   CheckoutSession?  @relation(fields: [checkoutSessionId], references: [id], onDelete: SetNull)
  createdAt         DateTime          @default(now())

  @@index([expiresAt, releasedAt])
}

model InventoryMovement {
  id         String            @id @default(cuid())
  variantId  String
  locationId String
  type       MovementType
  quantity   Int
  reason     String
  actorId    String?
  orderId    String?
  variant    ProductVariant    @relation(fields: [variantId], references: [id], onDelete: Restrict)
  location   InventoryLocation @relation(fields: [locationId], references: [id], onDelete: Restrict)
  createdAt  DateTime          @default(now())

  @@index([variantId, createdAt])
}

model Cart {
  id               String            @id @default(cuid())
  tokenHash        String            @unique
  customerId       String?
  affiliateId      String?
  currency         String            @default("INR")
  couponId         String?
  coupon           Coupon?           @relation(fields: [couponId], references: [id], onDelete: SetNull)
  customer         Customer?         @relation(fields: [customerId], references: [id], onDelete: SetNull)
  affiliate        Affiliate?        @relation(fields: [affiliateId], references: [id], onDelete: SetNull)
  expiresAt        DateTime
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  items            CartItem[]
  checkoutSessions CheckoutSession[]

  @@index([customerId, updatedAt])
  @@index([affiliateId, updatedAt])
}

model CartItem {
  id        String          @id @default(cuid())
  cartId    String
  productId String
  variantId String?
  quantity  Int
  cart      Cart            @relation(fields: [cartId], references: [id], onDelete: Cascade)
  product   Product         @relation(fields: [productId], references: [id], onDelete: Restrict)
  variant   ProductVariant? @relation(fields: [variantId], references: [id], onDelete: Restrict)

  @@unique([cartId, productId, variantId])
}

model CheckoutSession {
  id             String                 @id @default(cuid())
  publicToken    String                 @unique
  cartId         String
  customerId     String?
  status         String                 @default("open")
  paymentMethod  PaymentMethod?
  quote          Json
  expiresAt      DateTime
  cart           Cart                   @relation(fields: [cartId], references: [id], onDelete: Restrict)
  customer       Customer?              @relation(fields: [customerId], references: [id], onDelete: SetNull)
  reservations   InventoryReservation[]
  shippingQuotes ShippingQuote[]
  quotes         CheckoutQuote[]
  order          Order?
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt
}

model CheckoutQuote {
  id                String          @id @default(cuid())
  checkoutSessionId String
  subtotalPaise     Int
  discountPaise     Int
  taxPaise          Int
  shippingPaise     Int
  codPaise          Int
  totalPaise        Int
  serviceable       Boolean
  payload           Json
  expiresAt         DateTime
  checkoutSession   CheckoutSession @relation(fields: [checkoutSessionId], references: [id], onDelete: Cascade)
  createdAt         DateTime        @default(now())
}

model ShippingQuote {
  id                String          @id @default(cuid())
  checkoutSessionId String
  pincode           String
  serviceable       Boolean
  chargePaise       Int
  provider          String          @default("manual")
  providerQuoteId   String?
  courierId         String?
  courierName       String?
  metadata          Json?
  estimatedFrom     DateTime?
  estimatedTo       DateTime?
  expiresAt         DateTime?
  checkoutSession   CheckoutSession @relation(fields: [checkoutSessionId], references: [id], onDelete: Cascade)
  createdAt         DateTime        @default(now())

  @@index([checkoutSessionId, createdAt])
}

model Customer {
  id                   String                 @id @default(cuid())
  email                String?                @unique
  fullName             String
  phone                String?                @unique
  phoneVerifiedAt      DateTime?
  emailVerifiedAt      DateTime?
  createdAt            DateTime               @default(now())
  updatedAt            DateTime               @updatedAt
  founderNumber        Int?                   @unique
  founderJoinedAt      DateTime?
  addresses            Address[]
  consents             CustomerConsent[]
  orders               Order[]
  checkouts            CheckoutSession[]
  notes                CustomerNote[]
  carts                Cart[]
  sessions             CustomerSession[]
  // Legacy relation retained so existing customer records remain readable;
  // new customer authentication uses Firebase Google/email identities.
  otpChallenges        CustomerOtpChallenge[]
  identities           CustomerIdentity[]
  waitlistReservations WaitlistReservation[]
}

model CustomerIdentity {
  id                String   @id @default(cuid())
  customerId        String
  firebaseProjectId String   @default("skinfox")
  provider          String
  providerUid       String
  email             String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  customer          Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@unique([firebaseProjectId, providerUid])
  @@index([customerId])
}

model Address {
  id           String   @id @default(cuid())
  customerId   String
  fullName     String
  phone        String
  addressLine1 String
  addressLine2 String?
  landmark     String?
  city         String
  state        String
  pincode      String
  label        String   @default("Home")
  isDefault    Boolean  @default(false)
  customer     Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([customerId, isDefault])
}

// Deprecated customer SMS OTP records. Kept for migration compatibility only;
// no active route creates or verifies these challenges.
model CustomerOtpChallenge {
  id         String    @id @default(cuid())
  customerId String?
  phone      String
  codeHash   String
  attempts   Int       @default(0)
  expiresAt  DateTime
  verifiedAt DateTime?
  createdAt  DateTime  @default(now())
  customer   Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)

  @@index([phone, createdAt])
  @@index([expiresAt, verifiedAt])
}

model CustomerSession {
  id                String    @id @default(cuid())
  tokenHash         String    @unique
  customerId        String
  firebaseProjectId String?
  firebaseUid       String?
  expiresAt         DateTime
  revokedAt         DateTime?
  lastSeenAt        DateTime  @default(now())
  ip                String?
  userAgent         String?
  createdAt         DateTime  @default(now())
  customer          Customer  @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId, expiresAt])
}

model CustomerConsent {
  id            String   @id @default(cuid())
  customerId    String
  type          String
  granted       Boolean
  policyVersion String
  consentAt     DateTime
  customer      Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
}

model CustomerNote {
  id          String   @id @default(cuid())
  customerId  String
  body        String
  createdById String?
  customer    Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())
}

model Order {
  id                     String                @id @default(cuid())
  publicToken            String                @unique
  orderNumber            String                @unique
  customerId             String?
  checkoutSessionId      String?               @unique
  status                 OrderStatus           @default(pending_payment)
  currency               String                @default("INR")
  subtotalPaise          Int
  discountPaise          Int
  taxPaise               Int
  shippingPaise          Int
  codPaise               Int
  totalPaise             Int
  shippingAddress        Json?
  billingAddress         Json?
  source                 String                @default("storefront")
  waitlistReservationId  String?               @unique
  pricingMode            String?
  pricingPercent         Int?
  mrpSubtotalPaise       Int?
  waitlistDiscountPaise  Int?
  reservationCreditPaise Int                   @default(0)
  remainingBalancePaise  Int?
  conversionSnapshot     Json?
  completionDeadlineAt   DateTime?
  convertedAt            DateTime?
  balancePaidAt          DateTime?
  customer               Customer?             @relation(fields: [customerId], references: [id], onDelete: SetNull)
  checkoutSession        CheckoutSession?      @relation(fields: [checkoutSessionId], references: [id], onDelete: SetNull)
  waitlistReservation    WaitlistReservation?  @relation(fields: [waitlistReservationId], references: [id], onDelete: SetNull)
  items                  OrderItem[]
  statusEvents           OrderStatusEvent[]
  notes                  OrderNote[]
  payments               Payment[]
  refunds                Refund[]
  shipments              Shipment[]
  returns                ReturnRequest[]
  affiliateAttribution   AffiliateAttribution?
  createdAt              DateTime              @default(now())
  updatedAt              DateTime              @updatedAt

  @@index([status, createdAt])
}

model Affiliate {
  id                 String                       @id @default(cuid())
  fullName           String
  email              String?                      @unique
  phone              String                       @unique
  panEncrypted       String
  panLast4           String
  whatsappNumber     String?
  city               String?
  state              String?
  payoutUpiId        String?
  status             AffiliateStatus              @default(pending)
  referralCode       String                       @unique
  approvedAt         DateTime?
  approvedById       String?
  rejectionReason    String?
  createdAt          DateTime                     @default(now())
  updatedAt          DateTime                     @updatedAt
  approvedBy         AdminUser?                   @relation("AffiliateApprover", fields: [approvedById], references: [id], onDelete: SetNull)
  carts              Cart[]
  sessions           AffiliateSession[]
  otpChallenges      AffiliateOtpChallenge[]
  clicks             AffiliateReferralClick[]
  attributions       AffiliateAttribution[]
  walletEntries      AffiliateWalletEntry[]
  redemptionRequests AffiliateRedemptionRequest[]

  @@index([status, createdAt])
}

model AffiliateSession {
  id          String    @id @default(cuid())
  tokenHash   String    @unique
  affiliateId String
  expiresAt   DateTime
  revokedAt   DateTime?
  lastSeenAt  DateTime  @default(now())
  ip          String?
  userAgent   String?
  createdAt   DateTime  @default(now())
  affiliate   Affiliate @relation(fields: [affiliateId], references: [id], onDelete: Cascade)

  @@index([affiliateId, expiresAt])
}

model AffiliateOtpChallenge {
  id          String     @id @default(cuid())
  affiliateId String?
  phone       String
  codeHash    String
  attempts    Int        @default(0)
  expiresAt   DateTime
  verifiedAt  DateTime?
  createdAt   DateTime   @default(now())
  affiliate   Affiliate? @relation(fields: [affiliateId], references: [id], onDelete: SetNull)

  @@index([phone, createdAt])
  @@index([expiresAt, verifiedAt])
}

model AffiliateReferralClick {
  id           String    @id @default(cuid())
  affiliateId  String
  cartId       String?
  referralCode String
  visitorHash  String?
  landingPath  String?
  createdAt    DateTime  @default(now())
  affiliate    Affiliate @relation(fields: [affiliateId], references: [id], onDelete: Cascade)

  @@index([affiliateId, createdAt])
  @@index([cartId, createdAt])
}

model AffiliateAttribution {
  id              String                @id @default(cuid())
  affiliateId     String
  orderId         String                @unique
  referralCode    String
  commissionPaise Int
  createdAt       DateTime              @default(now())
  affiliate       Affiliate             @relation(fields: [affiliateId], references: [id], onDelete: Restrict)
  order           Order                 @relation(fields: [orderId], references: [id], onDelete: Restrict)
  walletEntry     AffiliateWalletEntry?

  @@index([affiliateId, createdAt])
}

model AffiliateWalletEntry {
  id            String                      @id @default(cuid())
  affiliateId   String
  type          AffiliateWalletEntryType
  amountPaise   Int
  description   String
  attributionId String?                     @unique
  redemptionId  String?
  createdAt     DateTime                    @default(now())
  affiliate     Affiliate                   @relation(fields: [affiliateId], references: [id], onDelete: Restrict)
  attribution   AffiliateAttribution?       @relation(fields: [attributionId], references: [id], onDelete: SetNull)
  redemption    AffiliateRedemptionRequest? @relation(fields: [redemptionId], references: [id], onDelete: SetNull)

  @@index([affiliateId, createdAt])
}

model AffiliateRedemptionRequest {
  id            String                    @id @default(cuid())
  affiliateId   String
  amountPaise   Int
  status        AffiliateRedemptionStatus @default(requested)
  payoutUpiId   String?
  reviewedAt    DateTime?
  reviewedById  String?
  note          String?
  createdAt     DateTime                  @default(now())
  updatedAt     DateTime                  @updatedAt
  affiliate     Affiliate                 @relation(fields: [affiliateId], references: [id], onDelete: Restrict)
  reviewedBy    AdminUser?                @relation("AffiliateRedemptionReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  walletEntries AffiliateWalletEntry[]

  @@index([affiliateId, status, createdAt])
}

model OrderItem {
  id                    String          @id @default(cuid())
  orderId               String
  productId             String?
  variantId             String?
  productName           String
  variantName           String
  sku                   String
  size                  String
  primaryImage          String
  unitSellingPricePaise Int
  mrpPaise              Int?
  discountPaise         Int
  taxRateBps            Int
  taxPaise              Int
  finalLineTotalPaise   Int
  quantity              Int
  order                 Order           @relation(fields: [orderId], references: [id], onDelete: Restrict)
  product               Product?        @relation(fields: [productId], references: [id], onDelete: SetNull)
  variant               ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)
}

model OrderStatusEvent {
  id         String       @id @default(cuid())
  orderId    String
  fromStatus OrderStatus?
  toStatus   OrderStatus
  reason     String?
  actorId    String?
  order      Order        @relation(fields: [orderId], references: [id], onDelete: Cascade)
  createdAt  DateTime     @default(now())
}

model OrderNote {
  id        String   @id @default(cuid())
  orderId   String
  body      String
  actorId   String?
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
}

model Payment {
  id                String         @id @default(cuid())
  orderId           String
  provider          String
  providerOrderId   String?
  providerPaymentId String?
  amountPaise       Int
  status            PaymentStatus  @default(pending)
  capturedPaise     Int            @default(0)
  order             Order          @relation(fields: [orderId], references: [id], onDelete: Restrict)
  events            PaymentEvent[]
  refunds           Refund[]
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  @@index([providerPaymentId])
}

model PaymentEvent {
  id         String   @id @default(cuid())
  paymentId  String
  externalId String?
  type       String
  payload    Json
  payment    Payment  @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@unique([paymentId, externalId])
}

model Refund {
  id             String   @id @default(cuid())
  orderId        String
  paymentId      String
  amountPaise    Int
  reason         String
  idempotencyKey String   @unique
  status         String   @default("pending")
  actorId        String?
  order          Order    @relation(fields: [orderId], references: [id], onDelete: Restrict)
  payment        Payment  @relation(fields: [paymentId], references: [id], onDelete: Restrict)
  createdAt      DateTime @default(now())
}

model Shipment {
  id                 String          @id @default(cuid())
  orderId            String
  provider           String          @default("manual")
  providerOrderId    String?
  providerShipmentId String?
  courierId          String?
  courierName        String?
  trackingNumber     String?
  trackingUrl        String?
  labelUrl           String?
  manifestUrl        String?
  pickupId           String?
  providerStatus     String?
  status             String          @default("pending")
  metadata           Json?
  bookingError       String?
  bookedAt           DateTime?
  pickupScheduledAt  DateTime?
  lastSyncedAt       DateTime?
  packedWeightGrams  Int?
  lengthCm           Float?
  breadthCm          Float?
  heightCm           Float?
  order              Order           @relation(fields: [orderId], references: [id], onDelete: Restrict)
  events             ShipmentEvent[]
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt

  @@index([provider, providerShipmentId])
  @@index([trackingNumber])
}

model ShipmentEvent {
  id         String   @id @default(cuid())
  shipmentId String
  externalId String?
  status     String
  payload    Json?
  shipment   Shipment @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@unique([shipmentId, externalId])
}

model ReturnRequest {
