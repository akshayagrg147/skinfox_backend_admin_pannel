  email                String
  phone                String?
  pincode              String
  consent              Boolean
  consentAt            DateTime
  privacyPolicyVersion String
  source               String?
  status               String   @default("new")
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
}

/// A paid priority-access reservation. The pricing rule/value is captured at
/// join time so later Admin changes never alter a customer's entitlement.
model WaitlistReservation {
  id                   String         @id @default(cuid())
  publicToken          String         @unique
  waitlistId           String         @unique
  customerId           String
  status               WaitlistStatus @default(payment_pending)
  currency             String         @default("INR")
  depositPaise         Int
  discountPercent      Int
  pricingMode          String         @default("discount_off_mrp")
  pricingValuePaise    Int?
  phone                String
  consent              Boolean
  consentAt            DateTime
  termsVersion         String
  provider             String         @default("razorpay")
  providerOrderId      String?        @unique
  providerPaymentId    String?        @unique
  providerRefundId     String?        @unique
  paymentCapturedPaise Int            @default(0)
  refundPaise          Int            @default(0)
  refundStatus         String?
  joinedAt             DateTime?
  cancelledAt          DateTime?
  refundedAt           DateTime?
  idempotencyKey       String         @unique
  customer             Customer       @relation(fields: [customerId], references: [id], onDelete: Restrict)
  items                WaitlistItem[]
  convertedOrder       Order?
  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @updatedAt

  @@index([customerId, createdAt])
  @@index([status, createdAt])
}

model WaitlistItem {
  id            String              @id @default(cuid())
  reservationId String
  productId     String
  productName   String
  productSlug   String
  size          String
  quantity      Int
  reservation   WaitlistReservation @relation(fields: [reservationId], references: [id], onDelete: Cascade)
  product       Product             @relation(fields: [productId], references: [id], onDelete: Restrict)
  createdAt     DateTime            @default(now())

  @@unique([reservationId, productId])
  @@index([productId])
}

