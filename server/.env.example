DATABASE_URL=postgresql://skinfox:skinfox@localhost:5432/skinfox?schema=public
REDIS_URL=redis://localhost:6379
PORT=4000
TZ=Asia/Kolkata
STOREFRONT_ORIGIN=http://localhost:4173
ADMIN_ORIGIN=http://localhost:4174
AFFILIATE_ORIGIN=http://localhost:4175
COOKIE_SECRET=replace-with-at-least-32-random-characters
SESSION_TTL_DAYS=7
# Customer authentication uses Firebase Google and email/password providers.
# The Firebase web configuration belongs in the storefront build environment.
CUSTOMER_SESSION_TTL_DAYS=30
# Affiliate OTP is independent from customer Firebase auth.
AFFILIATE_OTP_MODE=static
AFFILIATE_TEST_OTP=123456
AFFILIATE_OTP_EXPOSE_TEST_CODE=true
# Firebase Admin service account JSON is server-only; never commit it.
FIREBASE_PROJECT_ID=skinfox
FIREBASE_SERVICE_ACCOUNT_JSON=
# Or point GOOGLE_APPLICATION_CREDENTIALS at a mounted service-account file.
GOOGLE_APPLICATION_CREDENTIALS=
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
SEED_ADMIN_NAME=SkinFox Admin
# Optional base32 TOTP secret for non-interactive first-admin MFA enrollment.
SEED_ADMIN_MFA_SECRET=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# Optional server-controlled launch promotion. The defaults are a 50% offer
# for the first 500 completed orders. Dates use ISO-8601 timestamps.
LAUNCH_PROMOTION_ID=skinfox-launch-50
LAUNCH_PROMOTION_ENABLED=true
LAUNCH_PROMOTION_PERCENT=50
LAUNCH_PROMOTION_MAX_ORDERS=500
LAUNCH_PROMOTION_STARTS_AT=
LAUNCH_PROMOTION_ENDS_AT=
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=skinfox
S3_ACCESS_KEY=minio
S3_SECRET_KEY=minio123
MAILPIT_URL=http://localhost:8025

# Optional ImageKit product-media storage. Keep the private key server-only;
# the admin browser receives only short-lived upload signatures.
IMAGEKIT_PRIVATE_KEY=
IMAGEKIT_PUBLIC_KEY=
IMAGEKIT_URL_ENDPOINT=https://ik.imagekit.io/your_imagekit_id
IMAGEKIT_UPLOAD_FOLDER=/skinfox/products

# Optional: enables Find My Care photo analysis. Without it the photo step
# falls back to the questions. Photos are analysed in-request and never stored.
ANTHROPIC_API_KEY=

# Model for Find My Care photo analysis. Defaults to claude-haiku-4-5 (cheapest).
PHOTO_ANALYSIS_MODEL=

# Delhivery B2C shipping (server-only; never expose these values to the browser)
SHIPPING_PROVIDER=manual
DELHIVERY_ENV=production
DELHIVERY_API_TOKEN=
DELHIVERY_API_BASE_URL=
DELHIVERY_CLIENT_NAME=
DELHIVERY_PICKUP_LOCATION=
DELHIVERY_PICKUP_PINCODE=
DELHIVERY_PICKUP_TIME=16:00:00
DELHIVERY_SELLER_NAME=
DELHIVERY_SELLER_ADDRESS=
DELHIVERY_SELLER_PINCODE=
DELHIVERY_SELLER_CITY=
DELHIVERY_SELLER_STATE=
DELHIVERY_SELLER_COUNTRY=India
DELHIVERY_SELLER_GST_TIN=
DELHIVERY_DEFAULT_HSN_CODE=
DELHIVERY_BILLING_MODE=E
DELHIVERY_WEBHOOK_TOKEN=
DELHIVERY_BOOKING_ENABLED=false
SHIPPING_DEFAULT_WEIGHT_KG=0.5
SHIPPING_DEFAULT_LENGTH_CM=
SHIPPING_DEFAULT_BREADTH_CM=
SHIPPING_DEFAULT_HEIGHT_CM=
