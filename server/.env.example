DATABASE_URL=postgresql://skinfox:skinfox@localhost:5432/skinfox?schema=public
REDIS_URL=redis://localhost:6379
PORT=4000
TZ=Asia/Kolkata
STOREFRONT_ORIGIN=http://localhost:4173
ADMIN_ORIGIN=http://localhost:4174
AFFILIATE_ORIGIN=http://localhost:4175
COOKIE_SECRET=replace-with-at-least-32-random-characters
SESSION_TTL_DAYS=7
# Customer OTP mode. Use `firebase` in production; static is local-only.
CUSTOMER_OTP_MODE=static
CUSTOMER_TEST_OTP=123456
CUSTOMER_OTP_EXPOSE_TEST_CODE=true
CUSTOMER_OTP_TTL_MINUTES=10
CUSTOMER_OTP_MAX_ATTEMPTS=5
CUSTOMER_OTP_RESEND_SECONDS=60
CUSTOMER_SESSION_TTL_DAYS=30
# Affiliate OTP remains independent from customer Firebase auth during migration.
AFFILIATE_OTP_MODE=static
AFFILIATE_TEST_OTP=123456
AFFILIATE_OTP_EXPOSE_TEST_CODE=true
# Firebase Admin service account JSON is server-only; never commit it.
FIREBASE_PROJECT_ID=skinfox
FIREBASE_SERVICE_ACCOUNT_JSON=
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
SEED_ADMIN_NAME=SkinFox Admin
# Optional base32 TOTP secret for non-interactive first-admin MFA enrollment.
SEED_ADMIN_MFA_SECRET=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=skinfox
S3_ACCESS_KEY=minio
S3_SECRET_KEY=minio123
MAILPIT_URL=http://localhost:8025
